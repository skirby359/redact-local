# Never commit matter data, keys, or review sheets.
# The tool writes these next to the documents, not in this repo, but if a
# matter folder ever lands here by mistake these rules keep it out of git.
_redact/
redacted/
* - redacted/
* - restored.*
key.csv
*key*.csv
review.html
*review*.html
names.txt
manifest.json
run.log

# Generated by scripts/install_skill.py (holds this machine's paths)
skill/SKILL.md

# Personal list additions that shouldn't be published
config/*.local.txt

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.model/
.venv/
venv/
